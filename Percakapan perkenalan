class Teman:
    nama = ""

    def perkenalan(self):
        print(f"Halo, nama saya {self.nama}.")

    def sapa(self, nama_teman):
        print(f"Halo {nama_teman}, saya {self.nama}!")


# Teman 1 = Aar
teman1 = Teman()
teman1.nama = "Aar"

# Teman 2 = Naseh
teman2 = Teman()
teman2.nama = "Naseh"


print("=== PERKENALAN ===")
teman1.perkenalan()
teman2.perkenalan()


print("\n=== PERCAKAPAN AAR DAN NASEH ===")
teman1.sapa("Naseh")
teman2.sapa("Aar")


print("\n=== OBROLAN MAKAN AYAM GECEK ===")
